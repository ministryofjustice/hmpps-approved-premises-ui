{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "moj/components/interruption-card/macro.njk" import interruptionCard %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% extends "../../partials/layout.njk" %}

{% set pageTitle = applicationName + " - " + pageHeading %}
{% set mainClasses = "app-container govuk-body" %}

{% block beforeContent %}
    {% if not showStopPage %}
        {{ govukBackLink({
            text: "Back",
            href: backLink
        }) }}
    {% endif %}
{% endblock %}

{% block content %}

    {% if showStopPage %}

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1>You cannot continue with this application</h1>
                <p class="govuk-body">This person's tier is missing.</p>
                <p class="govuk-body">They must have a tier to apply.</p>
                <p class="govuk-body">
                    <a class="govuk-link" href="{{ dashboardPath }}">Go to dashboard</a>
                </p>
            </div>
        </div>

    {% else %}

        {% call interruptionCard({
          heading: displayName(person) + " may be eligible for Short-term accommodation (CAS2)",
          primaryAction: {
            text: "Continue",
            href: continuePath
          }
          }) -%}
          <p>This is because they are Tier {{ tierScore }}</p>
          <p>If they can be safely managed in other types of accommodation, they will be rejected for Approved Premises. Reasons for rejection include:</p>
          <ul class="govuk-list govuk-list--bullet">
          <li>Approved Premises is not considered necessary or proportionate</li>
          <li>risks could be managed through control measures and other accommodation</li>
          <li>the primary concern for the person is risk of homelessness</li>
          </ul>
        {%- endcall %}

    {% endif %}

{% endblock %}
